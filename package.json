{
  "name": "fusellm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "FuseLLM: bring your own keys, wire AI models into circuits that plan, build, review and research on their own. Runs entirely in the browser.",
  "homepage": "https://fusellm.lowkey.tools/",
  "author": "Shrinath Prabhu <https://shrinath.me>",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/cloudflare-pages.mjs && node scripts/check-csp.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "icons": "node scripts/icons.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "mock": "node scripts/mock-llm.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "fflate": "^0.8.3",
    "gpt-tokenizer": "^4.0.0",
    "markdown-it": "^15.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  },
  "engines": {
    "node": ">=22"
  }
}
