{
  "name": "fusellm",
  "compatibility_date": "2026-09-12",
  "routes": [
    { "pattern": "fusellm.lowkey.tools", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/404",
      "/404.html"
    ]
  },
  "main": "worker/index.ts"
}
